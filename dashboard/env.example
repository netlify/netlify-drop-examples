# --- Database ---------------------------------------------------------------
# Provisioned automatically by `netlify database init` — do not set by hand.
# NETLIFY_DB_URL=

# --- Tier 2 data protection ---------------------------------------------------
# REQUIRED outside demo mode (the app fails closed without it). 32 bytes,
# base64: `openssl rand -base64 32`. Set as a SECRET site env var — never VITE_*.
# DATA_ENCRYPTION_KEY=

# --- Snowflake refresh (optional; turns on only when ALL are set) -------------
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=
# SNOWFLAKE_PRIVATE_KEY=   # PKCS#8 PEM (literal \n allowed) — SECRET
# SNOWFLAKE_WAREHOUSE=
# SNOWFLAKE_ROLE=
# SNOWFLAKE_DATABASE=
# SNOWFLAKE_SCHEMA=

# --- Salesforce opportunities refresh (optional; turns on only when ALL are set)
# Client credentials flow; also runs nightly at 04:00 UTC. See README > Salesforce.
# SALESFORCE_INSTANCE_URL=   # e.g. https://acme.my.salesforce.com
# SALESFORCE_CLIENT_ID=
# SALESFORCE_CLIENT_SECRET=  # SECRET

# --- Auth-only local dev ----------------------------------------------------
# @netlify/identity doesn't work outside a real Netlify deploy. When running
# `netlify dev` locally, set this to fake a logged-in user and turn auth on:
# AUTH_DEV_USER={"email":"you@example.com","roles":["admin"]}  (roles: viewer | editor | admin)

# --- Signups -----------------------------------------------------------------
# The first signup becomes admin; everyone after gets `viewer`
# (appConfig.memberRole). Nothing to set for that.

# Optional — restricts signups to one exact email domain (no subdomains).
# Unset means no restriction, which is correct for invite-only setups.
# ALLOWED_SIGNUP_DOMAIN=acme.com

# --- Hard purge (soft delete is always on; this only controls permanent
# deletion of already soft-deleted dataset batches) ----------------------------------
# Off by default and genuinely inert when off — no purge job runs, ever,
# and RECORD_RETENTION_DAYS below is never read. See README > Soft delete.
# PURGE_ENABLED=false
#
# REQUIRED once PURGE_ENABLED=true — no default, on purpose. A retention
# period is a compliance decision, not a safe engineering default.
# RECORD_RETENTION_DAYS=

# --- Notifications (optional, all no-op if unset) ----------------------------
# SLACK_WEBHOOK_URL=
# RESEND_API_KEY=
# NOTIFY_EMAIL_FROM=
# NOTIFY_EMAIL_TO=
